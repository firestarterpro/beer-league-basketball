# Copy to .env (same folder) and fill in. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
ESPN_LEAGUE_ID=
ESPN_YEAR=2027
# From your browser's cookies on fantasy.espn.com (both are long strings)
ESPN_S2=
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
# Your website address, once deployed (for the Sync Now button), e.g. https://beer-league.you.workers.dev
SITE_URL=
# Folder with pull_season.py and build_model.py, e.g. C:\Templar Archives\Basketball Bro\beer-league\model (heat rankings run after games)
BUILD_MODEL_DIR=
