---
// League settings and rules, read from league_settings (the docs' values) and scoring_models,
// plus Approvals & requests (merged in from the old /approvals page, Jason 2026-10-29).
import Base from "../layouts/Base.astro";
import { query } from "../lib/db";
import { ESPN } from "../lib/espn";
import { TIER_EMOJI } from "../lib/tiers";
import { MODEL_NAME, STAT_NAME, TIER_SOURCE_NAME, tierInfo } from "../lib/players";
import RankingsExplainer from "../components/RankingsExplainer.astro";
import ScoringExplainer from "../components/ScoringExplainer.astro";

const [settings, models, rules, info, [teamCount]] = await Promise.all([
  query(`SELECT setting_key, setting_value, source FROM league_settings`),
  query(`SELECT model_key, stat, points::float AS points FROM scoring_models ORDER BY model_key, points DESC, stat`),
  query(`SELECT section, text FROM rulebook ORDER BY section, effective_date`),
  tierInfo(),
  query(`SELECT count(*) FILTER (WHERE active)::int AS active, count(*) FILTER (WHERE active AND manager_assigned)::int AS managed,
                vote_threshold() AS votes FROM teams`),
]);
const tierSource = info.snapshot ? TIER_SOURCE_NAME[info.snapshot.source] ?? info.snapshot.source : "ESPN's projection rank";
const nextSource = info.ranking ? TIER_SOURCE_NAME[info.ranking] : "the commissioner's power ranking";
const S: Record<string, string> = Object.fromEntries(settings.map((r) => [r.setting_key, r.setting_value]));
const pending = new Set(settings.filter((r) => r.source === "placeholder" && (/^(tbd|none)$/.test(r.setting_value) || r.setting_key === "scoring_model"))
  .map((r) => r.setting_key));
const tbd = (k: string, show: (v: string) => string) => (pending.has(k) ? "To be decided (league poll)" : show(S[k] ?? ""));

const byModel: Record<string, { stat: string; points: number }[]> = {};
for (const m of models) (byModel[m.model_key] ||= []).push(m);
const current = S.scoring_model;
const slots = (S.starter_slots || "").split(",").filter(Boolean);
const pts = (n: number) => (n > 0 ? `+${n}` : `${n}`);

const sections: [string, [string, string][]][] = [
  ["Roster", [
    ["Roster spots", `${S.roster_size}: ${slots.join(", ")}${Number(S.bench_slots) ? `, ${S.bench_slots} UTIL/bench` : ""}${Number(S.ir_slots) ? `, plus ${S.ir_slots} IR (up to ${Number(S.roster_size) + Number(S.ir_slots)} with injuries)` : ""}`],
    ["UTIL / bench", Number(S.bench_slots) ? `${S.bench_slots}` : "None"],
    ["Centers", `At most ${S.center_max} per team`],
    ["Lineups lock", S.lineup_lock === "daily_first_game" ? "Each day at the first game's tip-off" : S.lineup_lock],
  ]],
  ["Draft", [
    ["Type", S.draft_type === "salary_cap" ? `Auction (salary cap), $${S.draft_budget} per team` : S.draft_type],
    ["When", tbd("draft_datetime", (v) => (v === "2026-10-25 18:00 CT" ? "Sunday, October 25, 2026 at 6pm Central" : v))],
    ["Keepers", S.keepers === "off" ? "None" : S.keepers],
  ]],
  ["Moves", [
    ["Waivers", `${S.waiver_period_days} days. Order resets weekly, worst record first.`],
    ["Acquisition limit", tbd("acquisition_limit", (v) => (v === "none" ? "No limit" : v))],
    ["Trades", S.trade_review === "none" ? "No review" : S.trade_review],
    ["Trade deadline", tbd("trade_deadline", (v) => (v === "none" ? "None" : /^\d{4}-\d{2}-\d{2}$/.test(v)
      ? new Date(`${v}T12:00:00Z`).toLocaleDateString("en-US", { dateStyle: "long", timeZone: "UTC" }) : v))],
  ]],
  ["League", [
    ["Teams", `${teamCount.active} now, room for up to ${info.maxTeams}. Everything (draft, votes) scales with the team count.`],
    ["Community votes", `Pass with ${teamCount.votes} yes votes (more than half of the ${teamCount.managed} managed teams)`],
  ]],
  ["Season", [
    ["Scoring", "Total points for the season (no head-to-head)"],
    ["Tiebreaker", tbd("tiebreaker", (v) => (v === "none" ? "None" : v))],
    ["Playoffs", tbd("playoff_format", (v) => (v === "none" ? "No playoffs: the most points at the end of the season wins" : v))],
  ]],
];
---
<Base title="Rules & approvals" active="/rules" fonts="family=Cabin+Sketch:wght@400;700">
  <section class="card">
    <h2>League rules</h2>
    <p class="small"><a href="#roster">Roster</a> · <a href="#tiers">Tiers</a> · <a href="#scoring">Scoring</a> · <a href="#approvals">Approvals & requests</a></p>
    <p class="muted small">From the league's documents. ESPN runs the league, so if ESPN ever shows something different, ask the LM.{" "}
      <a href={ESPN.settings} target="_blank" rel="noopener">ESPN's settings page ↗</a></p>
  </section>

  <div class="grid">
    {sections.map(([title, rows]) => (
      <section class="card" id={title.toLowerCase()}>
        <h2>{title}</h2>
        <dl class="settings">{rows.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
      </section>
    ))}
    <section class="card" id="tiers">
      <h2>Tiers</h2>
      <dl class="settings">
        <dt>{TIER_EMOJI.T1} Tier 1</dt><dd>Ranks 1–{S.tier1_max_rank}, guideline of {S.tier1_cap} per team</dd>
        <dt>{TIER_EMOJI.T2} Tier 2</dt><dd>Ranks {Number(S.tier1_max_rank) + 1}–{S.tier2_max_rank}, guideline of {S.tier2_cap} per team</dd>
        <dt>{TIER_EMOJI.T3} Tier 3</dt><dd>Rank {Number(S.tier2_max_rank) + 1} and up, no limit</dd>
        <dt>Ranked by</dt><dd>{info.snapshot?.source === "espn" ? <>Now: {tierSource}. From the next refresh: {nextSource}.</> : tierSource}</dd>
        <dt>Refresh</dt><dd>Every {S.tier_refresh_weeks} weeks, as a new numbered snapshot</dd>
        <dt>Caps</dt><dd>Noted on the site only, never enforced. No votes and no drops over tiers.</dd>
      </dl>
      <p class="small"><a href="/stats">See the stats table</a> · <a href="#how">How the rankings work</a></p>
    </section>
  </div>

  <section class="card" id="scoring">
    <h2>Scoring</h2>
    <p class="muted small">
      {pending.has("scoring_model") || !byModel[current]
        ? <>The league picks one of these three in a poll. ESPN is set up with <b>{MODEL_NAME[current] ?? current}</b> for now.</>
        : <>The league uses <b>{MODEL_NAME[current] ?? current}</b>. The other two are shown for comparison.</>}
      Double-, triple- and quadruple-double bonuses don't stack: a player gets only the biggest one.
    </p>
    <div class="grid">
      {Object.entries(byModel).sort(([a], [b]) => Number(b === current) - Number(a === current)).map(([key, rows]) => (
        <div class={`model${key === current && !pending.has("scoring_model") ? " mine" : ""}`}>
          <h3>{MODEL_NAME[key] ?? key}</h3>
          <table>
            <tbody>{rows.map((r) => <tr><td>{STAT_NAME[r.stat] ?? r.stat}</td><td class="num">{pts(r.points)}</td></tr>)}</tbody>
          </table>
        </div>
      ))}
    </div>
    <ScoringExplainer open />
    <RankingsExplainer />
  </section>

  {rules.length > 0 && (
    <section class="card">
      <h2>Rulebook</h2>
      <dl class="settings">{rules.map((r) => <><dt>{r.section}</dt><dd>{r.text}</dd></>)}</dl>
    </section>
  )}
  <section class="card stack" id="approvals">
  <h2 id="requests">Approvals & requests</h2>
  <p class="muted">
    For GMs who'd rather not use the ESPN app. Send a move here and the LM makes it in ESPN when they can.
    It's a best-effort favor: send time-sensitive moves early, or make them in ESPN yourself. Requests can't be cancelled. Trades stay in ESPN chat.
  </p>

  <div class="card muted empty" id="pick-first" data-emoji="👆">Pick your team at the top of the page.</div>
  <div class="card muted empty" id="not-opted" data-emoji="📵" hidden>Your team makes its moves in ESPN directly. Ask the LM if you'd like to send requests here.</div>

  <form class="card stack" id="action-form" hidden>
    <h2>New request</h2>
    <label class="row">What do you need?
      <select id="action-type">
        <option value="add_player">Add a free agent</option>
        <option value="drop_player">Drop a player</option>
        <option value="waiver_claim">Waiver claim</option>
        <option value="lineup_change">Lineup change</option>
        <option value="ir_move">IR move</option>
      </select>
    </label>
    <label class="row" data-for="add_player waiver_claim">Player to add
      <input id="add-search" list="add-list" placeholder="Start typing a name" autocomplete="off">
      <datalist id="add-list"></datalist>
    </label>
    {/* Card binder (#14): search results as trading cards; tap one to pick it. */}
    <div class="binder" id="add-binder" data-for="add_player waiver_claim" aria-label="Matching players" hidden></div>
    <label class="row" data-for="drop_player waiver_claim lineup_change ir_move">
      <span id="roster-label">Player</span>
      <select id="roster-player"></select>
    </label>
    {/* Chalkboard lineup (#15): drag a name (or tap a name, then a spot) to fill the date, slot and player. */}
    <div class="chalkboard" id="chalkboard" data-for="lineup_change" hidden>
      <p class="chalk-title">Starting lineup</p>
      <div class="chalk-grid">
        <div class="chalk-slots" id="chalk-slots" aria-label="Lineup spots"></div>
        <ul class="chalk-roster" id="chalk-roster" aria-label="Your roster"></ul>
      </div>
      <p class="chalk-hint">Drag a name onto a spot, or tap a name and then a spot.</p>
    </div>
    <label class="row" data-for="lineup_change">Date <input type="date" id="lineup-date"></label>
    <label class="row" data-for="lineup_change">Slot
      <select id="lineup-slot"><option>PG</option><option>SG</option><option>SF</option><option>PF</option><option>C</option><option>UTIL</option><option>Bench</option></select>
    </label>
    <div class="row" data-for="ir_move">
      <label class="row">Move to
        <select id="ir-to"><option value="IR">IR</option><option value="active">Starting lineup</option></select>
      </label>
      {/* Skateboard (#16): ollies whenever the IR move changes. */}
      <span class="ollie" aria-hidden="true"><img src="/img/toys/skateboard.webp" alt="" width="265" height="506"></span>
    </div>
    <div class="row"><button class="primary" type="submit">Send to LM</button></div>
    {/* Helper (#17), opt-in: tap "Need help?" to turn it on; "Don't show again" hides it for good on this device. */}
    <button type="button" class="helper-ask" id="helper-ask" hidden><img src="/img/fx/helper-bubble.webp" alt="Need help?" width="400" height="312"></button>
    <div class="helper" id="helper" hidden>
      <img class="helper-clip" src="/img/fx/helper.webp" alt="" width="397" height="560">
      <div class="helper-say">
        <p id="helper-text">Hi! I'm the Beer League helper. Pick what you need and I'll give you tips.</p>
        <div class="row">
          <button type="button" class="link" id="helper-ok">Thanks</button>
          <button type="button" class="link" id="helper-never">Don't show again</button>
        </div>
      </div>
    </div>
  </form>

  <section class="card" id="history" hidden>
    <h2>Your requests</h2>
    <div class="tablebox">
      <table>
        <thead><tr><th>Sent</th><th>Request</th><th>Status</th><th>LM note</th></tr></thead>
        <tbody id="history-body"></tbody>
      </table>
    </div>
  </section>

  <script is:inline src="/actions.js"></script>
  </section>
  <script is:inline src="/actions.js"></script>
</Base>
