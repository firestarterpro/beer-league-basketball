---
// Approvals and action requests on one page: community votes on restricted adds / IR returns,
// then the form GMs use to send a move to the LM.
import Base from "../layouts/Base.astro";
import PollCard from "../components/PollCard.astro";
import { loadPolls, managedTeams } from "../lib/polls";
import { one } from "../lib/db";

const [votes, teams, t] = await Promise.all([loadPolls("votes"), managedTeams(), one<{ n: number }>("SELECT vote_threshold() AS n")]);
const threshold = t?.n;
---
<Base title="Approvals & requests" active="/approvals" fonts="family=Cabin+Sketch:wght@400;700">
  <h1>Approvals & requests</h1>
  <p class="small"><a href="#approvals">Approvals</a> · <a href="#requests">Action requests</a></p>
  <h2 id="approvals">Approvals</h2>
  <p class="muted">
    Restricted free-agent adds and IR activations. The requesting GM starts with a Yes.
    A claim is Community-Approved with {threshold} Yes votes. The LM closes each vote after ESPN processes it.
  </p>
  {votes.length === 0 && <div class="card muted empty" data-emoji="🦓">No requests right now. The ref is on break.</div>}
  <div class="grid">
    {votes.map((p) => <PollCard poll={p} teams={teams} />)}
  </div>
  <script is:inline src="/polls.js"></script>

  <h2 id="requests">Action requests</h2>
  <p class="muted">
    For GMs who'd rather not use the ESPN app. Send a move here and the LM makes it in ESPN when they can.
    It's a best-effort favor: send time-sensitive moves early, or make them in ESPN yourself. Requests can't be cancelled. Trades stay in ESPN chat.
  </p>

  <div class="card muted empty" id="pick-first" data-emoji="👆">Pick your team at the top of the page.</div>
  <div class="card muted empty" id="not-opted" data-emoji="📵" hidden>Your team makes its moves in ESPN directly. Ask the LM if you'd like to send requests here.</div>

  <form class="card stack" id="action-form" hidden>
    <h2>New request</h2>
    <label class="row">What do you need?
      <select id="action-type">
        <option value="add_player">Add a free agent</option>
        <option value="drop_player">Drop a player</option>
        <option value="waiver_claim">Waiver claim</option>
        <option value="lineup_change">Lineup change</option>
        <option value="ir_move">IR move</option>
      </select>
    </label>
    <label class="row" data-for="add_player waiver_claim">Player to add
      <input id="add-search" list="add-list" placeholder="Start typing a name" autocomplete="off">
      <datalist id="add-list"></datalist>
    </label>
    {/* Card binder (#14): search results as trading cards; tap one to pick it. */}
    <div class="binder" id="add-binder" data-for="add_player waiver_claim" aria-label="Matching players" hidden></div>
    <label class="row" data-for="drop_player waiver_claim lineup_change ir_move">
      <span id="roster-label">Player</span>
      <select id="roster-player"></select>
    </label>
    {/* Chalkboard lineup (#15): drag a name (or tap a name, then a spot) to fill the date, slot and player. */}
    <div class="chalkboard" id="chalkboard" data-for="lineup_change" hidden>
      <p class="chalk-title">Starting lineup</p>
      <div class="chalk-grid">
        <div class="chalk-slots" id="chalk-slots" aria-label="Lineup spots"></div>
        <ul class="chalk-roster" id="chalk-roster" aria-label="Your roster"></ul>
      </div>
      <p class="chalk-hint">Drag a name onto a spot, or tap a name and then a spot.</p>
    </div>
    <label class="row" data-for="lineup_change">Date <input type="date" id="lineup-date"></label>
    <label class="row" data-for="lineup_change">Slot
      <select id="lineup-slot"><option>PG</option><option>SG</option><option>SF</option><option>PF</option><option>C</option><option>UTIL</option></select>
    </label>
    <div class="row" data-for="ir_move">
      <label class="row">Move to
        <select id="ir-to"><option value="IR">IR</option><option value="active">Starting lineup</option></select>
      </label>
      {/* Skateboard (#16): ollies whenever the IR move changes. */}
      <span class="ollie" aria-hidden="true"><img src="/img/toys/skateboard.webp" alt="" width="265" height="506"></span>
    </div>
    <div class="whoa small" id="heads-up" role="alert" hidden>
      <img class="whoa-stamp" src="/img/fx/latefee.webp" alt="" width="470" height="448">
      <b class="whoa-title">Whoa! Violation</b>
      <span>Heads up: this would put you over your tier caps. The LM may send it to a community vote.</span>
    </div>
    <div class="row"><button class="primary" type="submit">Send to LM</button></div>
    {/* Helper (#17), opt-in: tap "Need help?" to turn it on; "Don't show again" hides it for good on this device. */}
    <button type="button" class="helper-ask" id="helper-ask" hidden><img src="/img/fx/helper-bubble.webp" alt="Need help?" width="400" height="312"></button>
    <div class="helper" id="helper" hidden>
      <img class="helper-clip" src="/img/fx/helper.webp" alt="" width="397" height="560">
      <div class="helper-say">
        <p id="helper-text">Hi! I'm the Beer League helper. Pick what you need and I'll point out the tier caps.</p>
        <div class="row">
          <button type="button" class="link" id="helper-ok">Thanks</button>
          <button type="button" class="link" id="helper-never">Don't show again</button>
        </div>
      </div>
    </div>
  </form>

  <section class="card" id="history" hidden>
    <h2>Your requests</h2>
    <div class="tablebox">
      <table>
        <thead><tr><th>Sent</th><th>Request</th><th>Status</th><th>LM note</th></tr></thead>
        <tbody id="history-body"></tbody>
      </table>
    </div>
  </section>

  <script is:inline src="/actions.js"></script>
</Base>
