---
// The tier list as a sortable stats table. Rank by tier rank, league fantasy points
// or any power ranking; sort by any column; add stat groups with "More stats";
// tap a player for their card. Two expandable panels explain scoring and rankings.
// The tier info sits in a left column and ESPN on the right; both step aside while "More stats" is in use.
import Base from "../layouts/Base.astro";
import RankingsExplainer from "../components/RankingsExplainer.astro";
import ScoringExplainer from "../components/ScoringExplainer.astro";
import EspnCard from "../components/EspnCard.astro";
import { query } from "../lib/db";
import { ESPN } from "../lib/espn";
import { TIER_EMOJI, TIER_NAME } from "../lib/tiers";
import { HEAT, HEAT_NAME, MODEL_NAME, SPLITS, SPLIT_NAME, TIER_SOURCE_NAME, leagueModel, playerRows, tierInfo } from "../lib/players";

const [info, rows, model, models] = await Promise.all([
  tierInfo(),
  playerRows("season"),
  leagueModel(),
  query(`SELECT DISTINCT model_key FROM scoring_models ORDER BY model_key`),
]);
const snap = info.snapshot;
const fmtDate = (d: string) => new Date(d + "T12:00:00").toLocaleDateString("en-US", { dateStyle: "medium" });
const tierLabel = snap ? `Tier rank (${snap.source === "espn" ? "ESPN" : HEAT_NAME[snap.source] ?? "power ranking"})` : "Tier rank";
const data = { rows, model, heatName: HEAT_NAME, emoji: TIER_EMOJI, tierName: TIER_NAME, t1: info.t1, t2: info.t2,
  prevVersion: snap?.prev_version ?? null };
const PATCH = { T1: "/img/ui/tier-t1.webp", T2: "/img/ui/tier-t2.webp", T3: "/img/ui/tier-t3.webp" };
const GROUPS: [string, string][] = [
  ["shooting", "Shooting detail (FGM/FGA, FTM/FTA, 3PA, 3P%)"], ["more", "Minutes, games, boards, fouls, DD/TD, $ value"],
  ["defense", "Defense (NBA.com tracking)"], ["heat", "All 4 power rankings with scores and changes"],
];
---
<Base title="Tiers" active="/tiers" sides>
<div class="tiers-grid" id="pt-layout">
<aside class="tiers-info" aria-label="About the tiers">
  <section class="card">
    <h2>Tier list</h2>
    <div class="tier-key">
      <span><img class="patch" src={PATCH.T1} alt="" width="40" height="40"><b class="tier-emoji">{TIER_EMOJI.T1}</b> Ranks 1–{info.t1} · max {info.cap1} per team</span>
      <span><img class="patch" src={PATCH.T2} alt="" width="40" height="40"><b class="tier-emoji">{TIER_EMOJI.T2}</b> Ranks {info.t1 + 1}–{info.t2} · max {info.cap2} per team</span>
      <span><img class="patch" src={PATCH.T3} alt="" width="40" height="40"><b class="tier-emoji">{TIER_EMOJI.T3}</b> Ranks {info.t2 + 1}+ · no limit</span>
    </div>
    <p class="small">
      {snap
        ? <>This is tier snapshot <b>version {snap.version}</b>, built from <b>{TIER_SOURCE_NAME[snap.source] ?? snap.source}</b>
            {snap.run_date ? <> (run of {fmtDate(snap.run_date)})</> : ""}, in effect since {fmtDate(snap.effective_date)}. It refreshes every {info.weeks} weeks.</>
        : <>The tier list isn't ready yet. It shows up once the LM freezes the first tier snapshot.</>}
      {snap?.source === "espn" && info.ranking && <> The next refresh switches to {TIER_SOURCE_NAME[info.ranking]}.</>}
      {snap?.source === "espn" && !info.ranking && <> Tiers are moving to the commissioner's power ranking at the next refresh.</>}
    </p>
    <p class="muted small">Players on IR don't count toward the caps. Tap a player for his card. The gold rows are the top 25 of whatever you rank by.</p>
    <RankingsExplainer />
    <ScoringExplainer />
  </section>
</aside>
<div class="page-main">
  {rows.length > 0 && (
    <section class="card">
      <div class="stack" id="pt-controls">
        <div class="row">
          <label class="ctl">Rank by
            <select id="pt-view">
              <option value="tier">{tierLabel}</option>
              <option value="points">League points</option>
              {HEAT.map((k) => <option value={k}>{HEAT_NAME[k]}</option>)}
            </select>
          </label>
          <label class="ctl">Scoring
            <select id="pt-model">
              {models.map((m) => <option value={m.model_key} selected={m.model_key === model}>{MODEL_NAME[m.model_key] ?? m.model_key}{m.model_key === model ? " (league)" : ""}</option>)}
            </select>
          </label>
          <label class="ctl">Stats from
            <select id="pt-split">{SPLITS.map((s) => <option value={s}>{SPLIT_NAME[s]}</option>)}</select>
          </label>
          <button type="button" id="pt-more" aria-expanded="false" aria-controls="pt-groups">＋ More stats</button>
        </div>
        <fieldset class="pt-groups" id="pt-groups" hidden>
          <legend class="small">Add these columns</legend>
          {GROUPS.map(([k, label]) => <label class="ctl small"><input type="checkbox" value={k}> {label}</label>)}
        </fieldset>
        <div class="row">
          <input type="search" id="pt-search" placeholder="Find a player" aria-label="Find a player">
          <select id="pt-pos" aria-label="Position">
            <option value="">All positions</option>
            {["PG", "SG", "SF", "PF", "C"].map((p) => <option>{p}</option>)}
          </select>
          <select id="pt-show" aria-label="Show">
            <option value="all">Everyone</option>
            <option value="free">Free agents only</option>
            <option value="mine">My team only</option>
            <option value="top50">Top 50 only</option>
            <option value="movers">Biggest movers</option>
          </select>
          <label class="ctl small"><input type="checkbox" id="pt-pergame" checked> Per game</label>
          <a class="small" href={ESPN.players} target="_blank" rel="noopener">Add players in ESPN ↗</a>
        </div>
      </div>
    </section>
  )}

  {rows.length > 0 && (
    <section class="card">
      <p class="muted small" id="pt-count" aria-live="polite">{rows.length} players</p>
      <div class="tablebox pt-box">
        <table class="pt" id="pt">
          <thead><tr id="pt-head"></tr></thead>
          <tbody id="pt-body"></tbody>
        </table>
      </div>
      <p class="muted" id="pt-empty" hidden>No players match.</p>
      <p class="muted small" id="pt-note"></p>
    </section>
  )}
</div>
<aside class="page-side" aria-label="Fantasy Shortcuts"><EspnCard /></aside>
</div>
  <script is:inline type="application/json" id="pt-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")}></script>
  <script is:inline src="/tiers.js"></script>
</Base>
