---
import Base from "../layouts/Base.astro";
import PollCard from "../components/PollCard.astro";
import { loadPolls, managedTeams } from "../lib/polls";

const [polls, teams] = await Promise.all([loadPolls("generic"), managedTeams()]);
---
<Base title="Polls" active="/polls">
  <h1>Polls</h1>
  <p class="muted">Fun votes for the family. Everyone can see every result.</p>
  {polls.length === 0 && <div class="card muted empty" data-emoji="🗳️">No polls yet. The LM posts them here.</div>}
  <div class="grid">
    {polls.map((p) => <PollCard poll={p} teams={teams} />)}
  </div>
  <script is:inline src="/polls.js"></script>
</Base>
