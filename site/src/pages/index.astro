---
import Base from "../layouts/Base.astro";
import { query } from "../lib/db";
import { ESPN, dayLabel } from "../lib/espn";
import PetWall from "../components/PetWall.astro";
import RuleSnippet from "../components/RuleSnippet.astro";
import PowerSide from "../components/PowerSide.astro";
import { TIER_EMOJI } from "../lib/tiers";
import { MODEL_NAME, TIER_SOURCE_NAME, tierInfo } from "../lib/players";
import { cardRows } from "../lib/cards";
import TeamCard from "../components/TeamCard.astro";

const [notes, open, board, settings, [counts], info, waivers, cards] = await Promise.all([
  query(`SELECT n.body, n.tags, n.created_at, t.team_name
         FROM notes n LEFT JOIN teams t ON t.team_id = n.author_team_id
         WHERE n.visible AND NOT n.tags && ARRAY['team_change_request', 'team_change_approved']
         ORDER BY n.created_at DESC LIMIT 25`),
  query(`SELECT id, question, context_type FROM polls WHERE poll_is_open(id) ORDER BY created_at DESC`),
  query(`SELECT t.team_id, t.team_name, lower(t.abv) AS abv, t.gm_name, s.rank, s.total_points::float AS points,
                coalesce(b.t1_count, 0) AS t1, coalesce(b.t2_count, 0) AS t2, coalesce(b.t3_count, 0) AS t3
         FROM teams t LEFT JOIN standings s USING (team_id) LEFT JOIN team_badges b USING (team_id)
         WHERE t.active ORDER BY s.rank NULLS LAST, t.team_name`),
  query(`SELECT setting_key, setting_value FROM league_settings`),
  query(`SELECT count(*) FILTER (WHERE active)::int AS active, count(*) FILTER (WHERE active AND manager_assigned)::int AS managed,
                vote_threshold() AS votes FROM teams`),
  tierInfo(),
  // Players dropped in the last waiver period who haven't been picked up: the late-fee ticker (#19).
  query(`SELECT p.name, t.team_name, x."timestamp" AS dropped_at,
                x."timestamp" + make_interval(days => coalesce((SELECT setting_value::int FROM league_settings
                                                                WHERE setting_key = 'waiver_period_days'), 2)) AS clears_at
         FROM transactions x JOIN players p USING (player_id) LEFT JOIN teams t ON t.team_id = x.team_id
         WHERE x.type = 'drop'
           AND x."timestamp" > now() - make_interval(days => coalesce((SELECT setting_value::int FROM league_settings
                                                                       WHERE setting_key = 'waiver_period_days'), 2))
           AND NOT EXISTS (SELECT 1 FROM rosters r WHERE r.player_id = x.player_id)
         ORDER BY x."timestamp" DESC LIMIT 12`),
  cardRows(),
]);
const cardOf = Object.fromEntries(cards.map((c) => [c.team_id, c]));
// League (Central) time: the Worker itself runs on UTC.
const fmt = (d: string) => new Date(d).toLocaleString("en-US", { dateStyle: "medium", timeStyle: "short", timeZone: "America/Chicago" }) + " CT";
const openPolls = open.filter((p) => p.context_type === "generic" || p.context_type === "scrub_nominee");
const openVotes = open.filter((p) => p.context_type === "claim_approval" || p.context_type === "ir_activation");
// League settings, for the rule snippets that sit next to the parts they explain.
const S: Record<string, string> = Object.fromEntries(settings.map((r) => [r.setting_key, r.setting_value]));
const tierSource = info.snapshot
  ? (info.snapshot.source === "espn" && info.ranking
      ? `${TIER_SOURCE_NAME[info.snapshot.source]} now, moving to ${TIER_SOURCE_NAME[info.ranking]}`
      : TIER_SOURCE_NAME[info.snapshot.source] ?? info.snapshot.source)
  : "the commissioner's power ranking";
const scoringName = MODEL_NAME[S.scoring_model] ?? S.scoring_model ?? "the chosen model";
---
<Base title="Home" active="/" sides fonts="family=VT323&family=Silkscreen:wght@400;700">
<div class="home-grid">
<div class="home-main">
  <section class="card collapsible" id="alerts" hidden
           data-links={JSON.stringify({ team: ESPN.team(), players: ESPN.players, lineup: ESPN.lineup() })}>
    <h2>Heads up</h2>
    <ul class="alerts" id="alerts-list"></ul>
  </section>
  {/* Upcoming games with the Lineups section merged in (schedule.js). Lineups lock at each day's first tip-off. */}
  <section class="card collapsible" id="upcoming" data-links={JSON.stringify({ lineup: ESPN.lineup(), trades: ESPN.rosters })}>
    <div class="sec-head">
      <h2>Upcoming games</h2>
      <div class="tv-tabs" id="tv-tabs" role="tablist" aria-label="Game days"></div>
      <button type="button" class="link" id="upcoming-all">All teams</button>
    </div>
    <div id="upcoming-days"></div>
  </section>
  <PetWall />
  <section class="card collapsible" id="league">
    <div class="sec-head">
      <h2>The league</h2>
      <a class="rs-btn" href="/rules">All league rules →</a>
    </div>
    <div class="team-cards">
      {board.map((t) => (
        <div class="tcard-wrap">
          <div class="tcard" data-team={t.team_id} data-pet-team={t.abv ?? ""}>
            {cardOf[t.team_id]
              ? <TeamCard card={cardOf[t.team_id]} season={S.season} href={`/team/${t.abv}`} lazy />
              : <a class="muted" style="padding:12px" href={`/team/${t.abv}`}>{t.team_name}</a>}
          </div>
          <p class="tcard-foot small">
            <span>{t.gm_name ? `GM ${t.gm_name} · ` : ""}🤾 {t.t1} · ⛹️ {t.t2} · 🚶 {t.t3}</span>
            <button type="button" class="link dl-card" data-card-dl={t.abv}>⬇ Download card</button>
          </p>
        </div>
      ))}
    </div>
    <div class="snippets">
      <RuleSnippet title="Tiers & caps" href="/rules#tiers" icon={TIER_EMOJI.T1} cta="Tier rules">
        Players are ranked {TIER_EMOJI.T1} 1–{info.t1}, {TIER_EMOJI.T2} {info.t1 + 1}–{info.t2}, {TIER_EMOJI.T3} the rest.
        Guideline: up to {info.cap1} of each top tier (noted, not enforced). Ranked by {tierSource}.
      </RuleSnippet>
      <RuleSnippet title="Scoring" href="/rules#scoring" icon="📊" cta="Scoring details">
        Season-long points, no head-to-head and no playoffs. The league voted for {scoringName} scoring.
      </RuleSnippet>
    </div>
  </section>
  <div class="grid">
    <section class="card collapsible" id="open-now">
      <h2>Open now</h2>
      {/* The VHS shelf (#7): drag a tape to the right (or tap it) to check it out. */}
      <div class="vhs-shelf">
        {openVotes.length > 0 && (
          <a class="vhs" href="/rules#approvals" draggable="false">
            <img src="/img/fx/vhs-approvals.webp" alt="" width="300" height="499" draggable="false">
            <span class="vhs-sticker num">{openVotes.length} open</span>
            <span class="sr-only">{openVotes.length} approval {openVotes.length === 1 ? "vote" : "votes"} open</span>
          </a>
        )}
        {openVotes.length === 0 && (
          <div class="vhs-empty">
            <img src="/img/toys/rewind-sticker.webp" alt="" width="100" height="102">
            <p class="muted">{openPolls.length ? "No approvals waiting. Be kind, rewind." : "Nothing to vote on right now. Be kind, rewind."}</p>
          </div>
        )}
      </div>
      {openVotes.length > 0 && <p class="small muted vhs-hint">Drag a tape to the right, or tap it, to check it out.</p>}
      {openVotes.length > 0 && <p><a href="/rules#approvals">{openVotes.length} approval {openVotes.length === 1 ? "vote" : "votes"}</a>: {openVotes.map((p) => p.question).join(" · ")}</p>}
      {openPolls.length > 0 && <p><a href="#active-poll">{openPolls.length} {openPolls.length === 1 ? "poll" : "polls"}</a> open in the side column: {openPolls.map((p) => p.question).join(" · ")}</p>}
      <RuleSnippet title="How votes work" href="/rules#league" icon="🗳️" cta="Voting & moves">
        League votes pass with {counts.votes} yes
        {counts.votes === 1 ? " vote" : " votes"} (more than half of the {counts.managed} managed teams). Voting is voluntary.
      </RuleSnippet>
    </section>
    <section class="card collapsible" id="dash-card">
      <h2>League dashboards</h2>
      <p class="muted">Standings, rosters with tier badges, transactions, scoring leaders and power rankings.</p>
      <p><a href="/dashboards">Open the dashboards</a></p>
    </section>
  </div>
  {waivers.length > 0 && (
    <section class="card latefee-card collapsible" id="latefees">
      <img class="lf-stamp" src="/img/fx/latefee.webp" alt="" width="470" height="448" loading="lazy">
      <h2>On waivers</h2>
      <p class="muted small">Dropped in the last {Number(S.waiver_period_days) || 2} days. Claims go in ESPN; the late fee is just for fun.</p>
      <ul class="latefees">
        {waivers.map((w) => (
          <li data-dropped={new Date(w.dropped_at).toISOString()} data-clears={new Date(w.clears_at).toISOString()}>
            <span class="lf-who"><b>{w.name}</b><span class="muted small">{w.team_name ? `dropped by ${w.team_name}` : "dropped"}</span></span>
            <span class="lf-clock num" aria-label="Time until waivers clear">{fmt(w.clears_at)}</span>
            <span class="lf-fee num" aria-hidden="true">$0.00</span>
          </li>
        ))}
      </ul>
    </section>
  )}
  {/* League feed as an AIM chat window (#8): spin the jog wheel to scrub through the notes. */}
  <section class="card aim-card collapsible" id="feed-card">
    <h2>League feed</h2>
    {notes.length === 0
      ? <p class="muted empty" data-emoji="📭">No news yet.</p>
      : (
        <div class="aim-win">
          <div class="aim-title"><span>🏃 LeagueFeed · Instant Message</span><span class="aim-btns" aria-hidden="true"><i>_</i><i>□</i><i>×</i></span></div>
          <p class="aim-to small">To: <b>The whole league</b> · {notes.length} {notes.length === 1 ? "note" : "notes"}</p>
          <ul class="feed aim-log" id="feed" tabindex="0" aria-label="League feed">
            {notes.map((n) => (
              <li data-at={new Date(n.created_at).toISOString()}>
                <span><b class="aim-who">{n.team_name ?? "League"}:</b> {n.body}</span>
                <span class="ts">{fmt(n.created_at)}</span>
              </li>
            ))}
          </ul>
          {notes.length > 4 && (
            <div class="aim-foot">
              <span class="jog" role="slider" tabindex="0" aria-label="Scrub the league feed" aria-valuemin="1" aria-valuemax={notes.length} aria-valuenow="1"></span>
              <span class="small">Spin to scrub</span>
            </div>
          )}
        </div>
      )}
  </section>
</div>
<PowerSide side="left" />
<PowerSide side="right" />
</div>
  <script is:inline src="/schedule.js"></script>
  <script is:inline src="/alerts.js"></script>
  <script is:inline src="/toys-home.js" defer></script>
  <script is:inline src="/card-dl.js" defer></script>
  <script is:inline src="/collapse.js"></script>
  <script is:inline>
    (function () {
      const mark = () => document.querySelectorAll(".tcard").forEach((c) => c.classList.toggle("mine", c.dataset.team === window.BL.viewTeam()));
      mark();
      document.addEventListener("bl:team", mark);
    })();
  </script>
</Base>
