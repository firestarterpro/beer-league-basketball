---
// One of the power-ranking side columns that sit beside Home.
// left: an open poll (only while one is open), player spotlight, Per-minute power. right: New to the top 50, Per-week power.
// Fantasy Shortcuts live in the header bar (Base.astro).
import ActivePoll from "./ActivePoll.astro";
import HeatList from "./HeatList.astro";
import { TIER_EMOJI } from "../lib/tiers";
import { HEAT_NAME, heatTop, newToTop50, spotlight } from "../lib/players";

interface Props { side: "left" | "right" }
const { side } = Astro.props;
const [perMin, star] = side === "left" ? await Promise.all([heatTop("minutes_nba", 25), spotlight()]) : [[], null];
const [perWeek, arrivals] = side === "right" ? await Promise.all([heatTop("weekly_nba", 25), newToTop50()]) : [[], []];
---
{side === "left" ? (
  <aside class="home-side home-left" aria-label="Open poll, player spotlight and Minutes Power">
    <ActivePoll />
    {star && (
      <section class="card spotlight" id="spotlight">
        <h2>Player spotlight</h2>
        <p class="sp-name"><a href={`/player/${star.id}`}>{star.name}</a></p>
        <p class="muted small">{star.nba ?? ""}{star.pos?.length ? ` · ${star.pos.join("/")}` : ""} · tier rank {star.rank} {TIER_EMOJI[star.tier as keyof typeof TIER_EMOJI]}</p>
        {star.gp > 0
          ? <p class="small num">{star.pts} pts · {star.reb} reb · {star.ast} ast · {star.stl} stl · {star.blk} blk <span class="muted">({star.gp} {star.gp === 1 ? "game" : "games"})</span></p>
          : <p class="muted small">No games yet this season.</p>}
        <p class="sp-links small">
          <a class="rs-btn" href={`/player/${star.id}`}>Player card →</a>
          <a href={`https://www.facebook.com/search/videos/?q=${encodeURIComponent(star.name + " highlights")}`} target="_blank" rel="noopener">Highlights on Facebook ↗</a>
        </p>
        <p class="muted small">A new top-50 player every time the page loads.</p>
      </section>
    )}
    <HeatList title="Per-minute power" view="minutes_nba" rows={perMin}
      blurb={`${HEAT_NAME.minutes_nba}: production per 48 minutes, 30+ minutes per block. Top 25.`} />
  </aside>
) : (
  <aside class="home-side home-right" aria-label="New arrivals and Weekly Power">
    <section class="card side-list" id="new-top50">
      <h2>New to the top 50</h2>
      {arrivals.length === 0
        ? <p class="muted small">Nobody new since the last tier refresh.</p>
        : (
          <>
            <p class="muted small">Moved into tier ranks 1–50 at the last refresh.</p>
            <ol class="hl">
              {arrivals.map((a) => (
                <li>
                  <span class="hl-rank num">{a.rank}</span>
                  <span class="hl-who"><a href={`/player/${a.id}`}>{a.name}</a><span class="muted small">{a.nba ?? ""} · {TIER_EMOJI[a.tier as keyof typeof TIER_EMOJI]}</span></span>
                  <span class="hl-score small muted">{a.prev_rank ? `was ${a.prev_rank}` : "new"}</span>
                </li>
              ))}
            </ol>
          </>
        )}
      <a class="rs-btn" href="/stats?show=movers">Biggest movers →</a>
    </section>
    <HeatList title="Per-week power" view="weekly_nba" rows={perWeek}
      blurb={`${HEAT_NAME.weekly_nba}: weighted 5-game blocks plus defense. This sets the tiers. Top 25.`} />
  </aside>
)}
