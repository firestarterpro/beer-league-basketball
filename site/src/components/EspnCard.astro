---
// "Fantasy Shortcuts": big ESPN buttons in their own card: top of Home's left column, and the side column on every other page.
import { SHORTCUTS } from "../lib/espn";

const ESPN_ICON: Record<string, string> = {
  "My team": "👕", "League home": "🏠", "Add players": "➕", FantasyCast: "📺", Standings: "🏆", "Recent activity": "🔔",
  "Daily leaders": "🔥", "Waiver order": "📋", "Draft room": "🎯",
};
---
<section class="card espn-card">
  <h2>Fantasy Shortcuts</h2>
  <p class="muted small">ESPN runs the league: lineups, adds, drops and trades happen there.</p>
  <div class="espn-btns">
    {SHORTCUTS.map(([label, href, team]) => (
      <a class="espn-btn" href={href} target="_blank" rel="noopener" data-espn={team ? "team" : undefined}>
        <span aria-hidden="true">{ESPN_ICON[label] ?? "🏀"}</span>{label}
      </a>
    ))}
  </div>
</section>
